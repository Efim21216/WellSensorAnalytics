<Window xmlns="https://github.com/avaloniaui"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WellSensorAnalyticsGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="750"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterScreen"
        x:Class="WellSensorAnalyticsGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WellSensorAnalyticsGUI">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="Auto, *">
        <StackPanel Margin="10">
            <TextBlock Text="Файлы в директории:"
                       FontWeight="Bold"
                       Margin="0 0 0 10"
                       HorizontalAlignment="Center" />
            <ListBox ItemsSource="{Binding DataFiles}"
                     SelectedItem="{Binding SelectedFile}"
                     BorderBrush="LightGray"
                     BorderThickness="1" />
            <Button Content="Изменить диапазон времени" Command="{Binding GetDateRangeCommand}" Margin="0 10 0 0"/>
        </StackPanel>
        <Grid RowDefinitions="*, 300"
              Grid.Column="1">
            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="10"
                    Margin="5"
                    Grid.Row="0">
                <sp:AvaPlot Grid.Column="1"
                            Name="AvaPlot" />
            </Border>
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*">
                <StackPanel Margin="10">
                    <TextBlock Text="Алгоритмы:"
                               FontWeight="Bold"
                               Margin="0 0 0 10"
                               HorizontalAlignment="Center" />
                    <ListBox ItemsSource="{Binding ListOfAlgorithms}"
                             SelectedItem="{Binding SelectedAlgorithm}"
                             BorderBrush="LightGray"
                             BorderThickness="1" />
                </StackPanel>
                <Border Grid.Column="1"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="5">
                    <TextBlock Text="{Binding AlgorithmOutput}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
